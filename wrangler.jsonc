{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-88",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9b4b3ee5-b640-445a-b5cc-ca1be9e5ddd3","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "58c053d5caac4b1ca511e4ab141bca1e" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
